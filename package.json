{
  "name": "dsh-remote-explorer",
  "version": "0.7.3",
  "description": "远程开发启动器：把 dsh 装到远程主机并在本机浏览器中使用，凭据不离开本机",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/btsd321/dsh-remote-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btsd321/dsh-remote-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/btsd321/dsh-remote-explorer/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "ssh",
    "tunnel",
    "remote-development"
  ],
  "bin": {
    "dsh-remote-explorer": "bin/dsh-remote-explorer.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dsh-remote-explorer": "tsx src/cli/bin.ts",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "check:plugin": "tsx scripts/check-plugin.ts",
    "dev:plugin": "tsx scripts/dev-plugin.ts",
    "prepublishOnly": "tsx scripts/build-plugin.ts && tsx scripts/check-plugin.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ssh-config": "5.3.0",
    "ssh2": "1.17.0",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.1.6-0 || ^0.1.7-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/ssh2": "^1.15.0",
    "esbuild": "~0.28.0",
    "react": "^18.2.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
